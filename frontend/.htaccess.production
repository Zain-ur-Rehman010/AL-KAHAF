# AlKahaf Online Academy - Production .htaccess
# Upload this file to your production server and rename to .htaccess
# Optimized for cPanel/shared hosting

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

#########################
# FORCE HTTPS (SSL)
#########################
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

#########################
# CLEAN URL REWRITES
#########################

