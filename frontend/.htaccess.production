RewriteRule ^admin/instructor/edit/?$ src/pages/admin/instructor-edit.html [L]
RewriteRule ^admin/students/?$ src/pages/admin/students-list.html [L]
RewriteRule ^admin/users/?$ src/pages/admin/users-list.html [L]
RewriteRule ^admin/user/add/?$ src/pages/admin/user-add.html [L]
RewriteRule ^admin/enrollments/?$ src/pages/admin/enrollments-list.html [L]
RewriteRule ^admin/payments/?$ src/pages/admin/payments-list.html [L]
RewriteRule ^admin/blogs/?$ src/pages/admin/blog-list.html [L]
RewriteRule ^admin/notifications/?$ src/pages/admin/notifications.html [L]
RewriteRule ^admin/predefined-courses/?$ src/pages/admin/predefined-courses.html [L]
RewriteRule ^admin/welfare-programs/?$ src/pages/admin/welfare-programs.html [L]
RewriteRule ^admin/welfare-program/add/?$ src/pages/admin/welfare-program-add.html [L]

#########################
# REDIRECT OLD URLS (301 Permanent)
#########################
# This prevents anyone from accessing the old exposed URLs
RewriteRule ^src/pages/courses/course-grid\.html$ /courses [R=301,L]
RewriteRule ^src/pages/courses/course-list\.html$ /courses/list [R=301,L]
RewriteRule ^src/pages/courses/course-details\.html$ /course-details [R=301,L]
RewriteRule ^src/pages/auth/login\.html$ /login [R=301,L]
RewriteRule ^src/pages/auth/register\.html$ /register [R=301,L]
RewriteRule ^src/pages/student/(.+)\.html$ /student/$1 [R=301,L]
RewriteRule ^src/pages/instructor/(.+)\.html$ /instructor/$1 [R=301,L]
RewriteRule ^src/pages/admin/(.+)\.html$ /admin/$1 [R=301,L]

#########################
# SECURITY
#########################

# Prevent directory browsing
Options -Indexes

# Hide server signature
ServerSignature Off

# Protect hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

#########################
# PERFORMANCE
#########################

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Default to index.html for root
RewriteRule ^$ index.html [L]

# Serve static files directly (CSS, JS, images - must be AFTER clean URL rules)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Error pages
ErrorDocument 404 /index.html