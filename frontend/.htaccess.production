RewriteRule ^admin/profile/?$ src/pages/admin/admin-profile.html [L]
RewriteRule ^admin/settings/?$ src/pages/admin/admin-settings.html [L]
RewriteRule ^admin/courses/?$ src/pages/admin/courses-list.html [L]
RewriteRule ^admin/course/add/?$ src/pages/admin/course-add.html [L]
RewriteRule ^admin/course/edit/?$ src/pages/admin/course-edit.html [L]
