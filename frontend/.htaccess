# AlKahaf LMS - Frontend Routing Configuration

RewriteEngine On
DirectoryIndex index.html

# ── Backend API proxy ─────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^(.*)$ http://localhost:5000/$1 [P,L]

# ── Serve real files/directories as-is ───────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Section routing: clean URL → src/pages/<section>/<page>.html ─────────────

# /instructor/<page>  →  src/pages/instructor/<page>.html
RewriteRule ^instructor/([^/]+)/?$ /src/pages/instructor/$1.html [L]

# /student/<page>  →  src/pages/student/<page>.html
RewriteRule ^student/([^/]+)/?$ /src/pages/student/$1.html [L]

# /admin/<page>  →  src/pages/admin/<page>.html
RewriteRule ^admin/([^/]+)/?$ /src/pages/admin/$1.html [L]

# /courses/<page>  →  src/pages/courses/<page>.html
RewriteRule ^courses/([^/]+)/?$ /src/pages/courses/$1.html [L]

# /auth/<page>  →  src/pages/auth/<page>.html
RewriteRule ^auth/([^/]+)/?$ /src/pages/auth/$1.html [L]

# /shared/<page>  →  src/pages/shared/<page>.html
RewriteRule ^shared/([^/]+)/?$ /src/pages/shared/$1.html [L]

# /blog/<page>  →  src/pages/blog/<page>.html
RewriteRule ^blog/([^/]+)/?$ /src/pages/blog/$1.html [L]

# ── Homepage ──────────────────────────────────────────────────────────────────
RewriteRule ^$ /index.html [L]

# ── 404 fallback ─────────────────────────────────────────────────────────────
ErrorDocument 404 /index.html
